# Copy to .env and fill in. Never commit .env. Never give these values to the frontend.

APP_NAME=fysi
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (Supabase Postgres) ---------------------------------------------
# Supabase dashboard -> Connect -> "Session pooler" (port 5432, works over IPv4).
# Format: postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# Do NOT use the transaction pooler (port 6543): migrations need session-level locks.
DATABASE_URL=
# Optional separate URL for `pnpm db:migrate`; falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Keep small: the free session pooler caps client connections.
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_STARTUP_ATTEMPTS=5

# --- Redis (Upstash) ------------------------------------------------------------
# Upstash -> your database -> the rediss:// URL (double s = TLS).
REDIS_URL=

# --- Auth -------------------------------------------------------------------------
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
# Customers and vendors: a session ends after this many days without a refresh.
REFRESH_TOKEN_TTL_DAYS=30
# Admins and super admins: a session ends after this many minutes without a refresh.
ADMIN_SESSION_IDLE_MINUTES=60
OTP_TTL_MINUTES=10
# Roles that must turn on an authenticator app (PRD: vendors and admins).
MFA_REQUIRED_ROLES=vendor,admin,super_admin

# --- Encryption at rest -------------------------------------------------------------
# 32 random bytes, base64. Encrypts 2FA secrets and directors' NIN/BVN.
# Losing or changing it makes those unreadable: back it up with the database credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# --- Email ------------------------------------------------------------------------
# Empty prints emails (with their codes) to the console. Refused when NODE_ENV=production.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. Fysi <no-reply@fysi.ng>
MAIL_FROM=
# Staging only: deliver every email to this one inbox (the subject names the real recipient).
# Needed with Resend's test sender onboarding@resend.dev, which only reaches the account owner.
MAIL_REDIRECT_TO=
# Staging servers only: with NODE_ENV=production and no RESEND_API_KEY, print emails to the logs
# instead of refusing to start. Never true on the launch server.
MAIL_CONSOLE_IN_PRODUCTION=false

# --- File storage (Supabase Storage, S3 protocol) -----------------------------------
# Supabase -> Storage -> create a PRIVATE bucket (e.g. fysi-media). It holds product photos,
# logos, avatars and vendor KYB documents; the API hands out short-lived signed links.
# Supabase -> Project Settings -> Storage -> S3 Connection: copy endpoint + region, create an access key.
# The keys bypass all Supabase security rules: server only, never in the frontend.
# Empty S3_BUCKET disables uploads (503).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_DOWNLOAD_TTL_SECONDS=3600

# --- Frontend / HTTP ----------------------------------------------------------------
# Main frontend address. Allowed by CORS automatically and linked in emails.
FRONTEND_URL=http://localhost:3000
# Extra comma-separated origins (previews, a second domain). Exact origins, no paths.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Reverse proxies in front of the app. Render = 1, local = 0.
TRUST_PROXY_HOPS=0
# Serves Swagger UI at /docs and the OpenAPI JSON at /docs-json.
SWAGGER_ENABLED=true

# Global token bucket per user (or per IP when anonymous).
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1

# --- Stellar ----------------------------------------------------------------------
# testnet during build and QA. mainnet also needs STELLAR_ALLOW_MAINNET=true (after the
# security review and legal sign-off, PRD release step 3).
STELLAR_NETWORK=testnet
STELLAR_ALLOW_MAINNET=false
# Empty = SDF's public Horizon for the network.
STELLAR_HORIZON_URL=
# Settlement asset: USDC only (PRD decision). Circle's testnet issuer below;
# mainnet USDC has a different issuer.
STELLAR_ASSETS=USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Unused: platform keys live with the custody provider (WALLET_PROVIDER).
STELLAR_PLATFORM_SECRET=

# --- Payments (phase 2) -------------------------------------------------------------
# Custody of custodial keys. `local` = encrypted in this database with DATA_ENCRYPTION_KEY,
# testnet only (refused on mainnet). An MPC provider (e.g. DFNS) replaces it for the pilot.
WALLET_PROVIDER=local
# Checkout holds stock and the QR/link stay valid this long.
PAYMENT_WINDOW_MINUTES=15
# A part-paid order stays open this long for the balance, then expires and is refunded.
PARTIAL_PAYMENT_GRACE_HOURS=24
# 500 = 5%. Founding vendors pay 0% for FOUNDING_VENDOR_FREE_DAYS after approval.
COMMISSION_BPS=500
FOUNDING_VENDOR_FREE_DAYS=90
# Escrow releases this long after Shipped; problems can be reported this long after delivery.
ESCROW_AUTO_RELEASE_DAYS=7
PROBLEM_REPORT_DAYS=7
# Payment watcher poll (ms) and sweeper (s). 0 turns either off.
WATCHER_INTERVAL_MS=3000
SWEEP_INTERVAL_SECONDS=30
# US cents.
WITHDRAWAL_DAILY_LIMIT_CENTS=100000
CUSTOMER_TIER1_CAP_CENTS=20000
